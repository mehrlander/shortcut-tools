				<key>WFTextActionText</key>
				<string>&lt;!doctype html&gt;
&lt;meta charset="utf-8"&gt;
&lt;title&gt;Session lines&lt;/title&gt;
&lt;style&gt;
  /* The page has one consumer that matters: a rich-text coercion, which runs
     the script and reads the text back. So the visible text is only ever the
     lines themselves. No headings, no buttons, nothing an extraction would
     pick up and a downstream split would miscount. Same contract, and the same
     reasoning, as pages/gh-recent-branches.html. */
  body { font: 15px/1.5 ui-monospace, Menlo, monospace; margin: 0; padding: .75rem; }
  #out { white-space: pre; overflow-x: auto; }
&lt;/style&gt;
&lt;div id="out"&gt;&lt;/div&gt;

&lt;script&gt;
// session-lines.html: the session picker's data, computed on the phone.
//
// Not a page anybody is meant to look at. Claude-Session builds it into a
// data: URL, coerces that URL to rich text (which runs this script and returns
// its text), and feeds the result to Shortcuts' own Choose from List. The menu
// is native; this only supplies what goes in it.
//
// The output is one caption, then the rows, joined by the separator below:
//
//   &lt;caption&gt;§§&lt;id&gt; · this branch · 2h · &lt;the ask&gt;
//            &lt;id&gt; · 5h · &lt;the ask&gt;
//
// The caption becomes the menu's prompt and the rows become its items, so the
// split is by separator first and by newline second. A row leads with its
// eight-hex id because the chain recovers the id by deleting from the first
// " · " onward, which is the one extraction this repository has already proven
// (gh-recent-branches-picker). Nothing later in a row can break it.
//
// Two values arrive by substitution before this runs: the GitHub token, from
// the injector that owns it, and the clipboard as base64, which is where the
// branch comes from. Neither travels in an address. The placeholder below is
// the only place its name may be spelled, since naming the injector in a
// comment would paste the live token into that comment.

// Each placeholder is spelled once in this file, comments included. The
// sentinels are built from halves so the substitution cannot reach them.
var CLIP = '📋ClipboardBase64';
var TOKEN = '🎟️GitHubToken';
var CLIP_KEY = '📋' + 'ClipboardBase64';
var TOKEN_KEY = '🎟️' + 'GitHubToken';

var STORE = 'mehrlander/web-tools-private';
var INDEX = 'state/sessions.json';
var SEP = '§§';
var ROWS = 14;          // rows offered when the branch does not fill the list
var ASK = 64;           // characters of the ask a row carries, about two phone lines

function fromB64(b64) {
  var raw = atob(b64);
  return new TextDecoder().decode(Uint8Array.from(raw, function (c) { return c.charCodeAt(0); }));
}

// What the Claude app puts on the clipboard has varied, so a full ref, a URL
// carrying one, or the bare name all reduce to the name. Only the first line
// counts, since a clipboard can hold a caption whose first line is the branch.
function branchOf(text) {
  var s = String(text || '').trim().split(/\r?\n/)[0].trim();
  s = s.replace(/^.*?(?:tree\/|compare\/|branch\.html#gh=[^@]+@|branch=)/, '')
       .replace(/^origin\//, '').replace(/^refs\/heads\//, '')
       .replace(/[?#&amp;].*$/, '').replace(/\/$/, '');
  return /\//.test(s) &amp;&amp; !/\s/.test(s) ? s : '';
}

// The stored token may or may not carry its scheme. Accept either rather than
// making the config file's exact contents load-bearing.
function auth(token) {
  return /^(Bearer|token) /i.test(token) ? token : 'Bearer ' + token;
}

// Synchronous on purpose, and this is the rule the whole page turns on: the
// coercion captures the document at a moment nobody has documented, and a
// promise that resolves after it returns empty with no error. Blocking the
// load is the only safe shape here.
function readIndex(token) {
  var x = new XMLHttpRequest();
  x.open('GET', 'https://api.github.com/repos/' + STORE + '/contents/' + INDEX + '?ref=main', false);
  x.setRequestHeader('Authorization', auth(token));
  // Raw, not the contents envelope: the envelope base64s the body and this one
  // is 877 KB before encoding.
  x.setRequestHeader('Accept', 'application/vnd.github.raw');
  x.send();
  if (x.status !== 200) throw new Error('HTTP ' + x.status + ' reading ' + INDEX);
  return JSON.parse(x.responseText);
}

function onBranch(row, branch) {
  return !!branch &amp;&amp; ((row.branches || []).indexOf(branch) &gt;= 0
    || (row.repos || []).some(function (r) { return r &amp;&amp; r.branch === branch; }));
}

function byStarted(a, b) { return a.started &lt; b.started ? 1 : a.started &gt; b.started ? -1 : 0; }

function ago(iso) {
  var mins = Math.round((Date.now() - Date.parse(iso)) / 60000);
  if (!isFinite(mins)) return '';
  if (mins &lt; 60) return mins + 'm';
  if (mins &lt; 1440) return Math.round(mins / 60) + 'h';
  return Math.round(mins / 1440) + 'd';
}

// An ask is markdown and a menu row is not, so the loudest syntax goes: fences,
// a link's brackets and URL, emphasis and heading marks.
function plain(md) {
  return String(md || '').replace(/```[\s\S]*?```/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_`#&gt;]+/g, '')
    // The separator is structure, so an ask that happens to contain it would
    // split the caption off the rows and take the rows with it.
    .split(SEP).join(' ').replace(/\s+/g, ' ').trim();
}

function row(r, here) {
  var ask = plain(r.ask);
  if (ask.length &gt; ASK) ask = ask.slice(0, ASK - 1) + '…';
  return [r.id, (here ? 'this branch' : ''), ago(r.started), ask]
    .filter(Boolean).join(' · ');
}

// Branch matches first, then the most recent regardless, so the list is never
// empty and never hides what it did not find. The caption says which case this
// is, in words, because the rows alone cannot: a list with no marked row could
// mean the branch had no session or that no branch was on the clipboard.
function build(rows, branch, at) {
  var here = branch ? rows.filter(function (r) { return onBranch(r, branch); }).sort(byStarted) : [];
  var seen = {};
  here.forEach(function (r) { seen[r.id] = true; });
  var rest = rows.slice().sort(byStarted).filter(function (r) { return !seen[r.id]; })
                 .slice(0, Math.max(0, ROWS - here.length));

  var caption = !branch ? 'No branch on the clipboard, showing recent'
    : here.length ? here.length + ' on ' + branch
    : 'No session on ' + branch + ' yet, showing recent';
  if (at) caption += ' · index ' + ago(at);

  var lines = here.map(function (r) { return row(r, true); })
        .concat(rest.map(function (r) { return row(r, false); }));
  return caption + SEP + lines.join('\n');
}

function run() {
  if (TOKEN === TOKEN_KEY) return 'ERROR no token substituted; Inject-' + TOKEN_KEY + ' did not run';
  try {
    var idx = readIndex(TOKEN);
    return build(idx.rows || [], branchOf(CLIP === CLIP_KEY ? '' : fromB64(CLIP)), idx.generatedAt);
  } catch (err) {
    return 'ERROR ' + err.message;
  }
}

document.getElementById('out').textContent = run();
&lt;/script&gt;
</string>
