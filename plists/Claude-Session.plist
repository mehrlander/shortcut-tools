<dict>
	<key>WFQuickActionSurfaces</key>
	<array/>
	<key>WFWorkflowActions</key>
	<array>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>is.workflow.actions.gettext</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>UUID</key>
				<string>C1A5E550-0001-4A00-9000-000000000001</string>
				<key>WFTextActionText</key>
				<string>&lt;!doctype html&gt;
&lt;html lang="en" data-theme="winter"&gt;
&lt;meta charset="utf-8"&gt;
&lt;meta name="viewport" content="width=device-width, initial-scale=1"&gt;
&lt;title&gt;Claude session&lt;/title&gt;
&lt;link href="https://cdn.jsdelivr.net/combine/npm/daisyui@5/themes.css,npm/daisyui@5" rel="stylesheet"&gt;
&lt;script src="https://cdn.jsdelivr.net/combine/npm/@tailwindcss/browser@4,npm/@phosphor-icons/web"&gt;&lt;/script&gt;
&lt;script src="https://cdn.jsdelivr.net/gh/mehrlander/web-tools@main/lib/kits/read-aloud.js"&gt;&lt;/script&gt;
&lt;script defer src="https://unpkg.com/alpinejs"&gt;&lt;/script&gt;

&lt;!--
  claude-session.html: the session behind the copied branch, read aloud on the
  phone, with every step it takes shown on the page.

  Delivered through Show-Html, so two values arrive by substitution before any
  script runs: the clipboard as base64 and the GitHub token. Neither travels in
  a URL, which is the failure this page replaces: Choose-Claude built
  session.html#branch= around the clipboard and the page opened empty. Here the
  header prints what the clipboard held and what it reduced to, so the next run
  answers that question instead of leaving it open.

  The reading is the same one pages/session.html gives: a card per ask, the ask
  and the prose replies spoken, the tool calls left on the screen. The reduction
  is web-tools' kits/read-aloud.js, loaded from jsDelivr, so what is heard here
  and there is one function.

  The index read is web-tools-private/state/sessions.json, one file naming every
  record with its branches, rather than the walk session-brief does through
  whole records: one fetch resolves the branch, and the rest of the index is the
  fallback list when the clipboard held something else.
--&gt;

&lt;script id="logic"&gt;
// Two placeholders, each spelled once in this file, comments included. The
// sentinels are built from halves so the substitution cannot reach them.
var CLIP = '📋ClipboardBase64';
var TOKEN = '🎟️GitHubToken';
var CLIP_KEY = '📋' + 'ClipboardBase64';
var TOKEN_KEY = '🎟️' + 'GitHubToken';

var STORE = 'mehrlander/web-tools-private';
var INDEX = 'state/sessions.json';
var API = 'https://api.github.com/repos/' + STORE + '/contents/';
var SESSION_PAGE = 'https://mehrlander.github.io/web-tools/pages/session.html#id=';
var NEW_TOKEN = 'https://github.com/settings/tokens/new?scopes=repo&amp;description=shortcut-tools';
var SPEAKER = 'Speak-Text';
var LATEST = 12;

function fromB64(b64) {
  var raw = atob(b64);
  return new TextDecoder().decode(Uint8Array.from(raw, function (c) { return c.charCodeAt(0); }));
}

// The same tolerance session.html applies: a full ref, a URL carrying one, or
// the bare name all reduce to the name. Only the first line counts, since a
// clipboard can hold a caption with the branch on its first line.
function branchOf(text) {
  var s = String(text || '').trim().split(/\r?\n/)[0].trim();
  s = s.replace(/^.*?(?:tree\/|compare\/|branch\.html#gh=[^@]+@|branch=)/, '')
       .replace(/^origin\//, '').replace(/^refs\/heads\//, '')
       .replace(/[?#&amp;].*$/, '').replace(/\/$/, '');
  return /\//.test(s) &amp;&amp; !/\s/.test(s) ? s : '';
}

function auth(token) {
  return /^(Bearer|token) /i.test(token) ? token : 'Bearer ' + token;
}

function onBranch(row, branch) {
  return !!branch &amp;&amp; ((row.branches || []).indexOf(branch) &gt;= 0
    || (row.repos || []).some(function (r) { return r &amp;&amp; r.branch === branch; }));
}

// Newest first, by `started`, which is what the index's rows already carry.
function byStarted(a, b) { return a.started &lt; b.started ? 1 : a.started &gt; b.started ? -1 : 0; }

function matches(rows, branch) {
  return (rows || []).filter(function (r) { return onBranch(r, branch); }).sort(byStarted);
}

function latest(rows, n) {
  return (rows || []).slice().sort(byStarted).slice(0, n || LATEST);
}

function recordPath(row) {
  var day = row.day || '';
  return 'sessions/' + day.slice(0, 4) + '/' + day.slice(5, 7) + '/' + day + '-' + row.id + '.json';
}

// A card per ask: the ask and every prose reply before the next ask, in time
// order. Tool calls are not read, which is session-render's rule too. A record
// with no replies still has `last_message`, the one sentence that survived.
// A preview line is read, not spoken, so only the loudest syntax goes: bold
// and code marks, a link's brackets and its URL, a heading's hashes.
function plain(md) {
  return String(md || '').replace(/```[\s\S]*?```/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_`#&gt;]+/g, '').replace(/\s+/g, ' ').trim();
}

function cards(record) {
  var r = record || {};
  var turns = [];
  (r.prompts || []).forEach(function (p) { turns.push({ role: 'user', at: p.at || '', md: p.text || '' }); });
  (r.replies || []).forEach(function (x) { turns.push({ role: 'assistant', at: x.at || '', md: x.text || '' }); });
  turns.forEach(function (t, i) { t._i = i; });
  turns.sort(function (a, b) {
    return (a.at &lt; b.at ? -1 : a.at &gt; b.at ? 1 : 0)
      || ((a.role === 'user' ? 0 : 1) - (b.role === 'user' ? 0 : 1)) || (a._i - b._i);
  });
  if (!(r.replies || []).length &amp;&amp; r.last_message) turns.push({ role: 'assistant', at: '', md: r.last_message });
  var out = [];
  turns.forEach(function (t) {
    if (!out.length || t.role === 'user') out.push({ ask: '', replies: [], at: t.at });
    var c = out[out.length - 1];
    if (t.role === 'user') c.ask = t.md; else if (t.md) c.replies.push(t.md);
  });
  return out.map(function (c, i) {
    var lead = plain(c.ask || c.replies[0] || '');
    return {
      key: i,
      label: 'Card ' + (i + 1),
      ts: (c.at || '').slice(11, 16),
      ask: c.ask,
      lead: lead.length &gt; 140 ? lead.slice(0, 139) + '…' : lead,
      closing: plain(c.replies[c.replies.length - 1] || '').slice(0, 200),
      md: [c.ask].concat(c.replies).filter(Boolean).join('\n\n'),
    };
  });
}

// The card handed to Shortcuts' own Speak Text, already reduced to speech so
// the receiver has nothing to strip. The link is long and that is fine: a
// shortcuts:// URL carries kilobytes, and pack links are far larger.
function speakLink(text) {
  return 'shortcuts://run-shortcut?name=' + encodeURIComponent(SPEAKER)
    + '&amp;input=text&amp;text=' + encodeURIComponent(text || '');
}

function ago(iso) {
  var mins = Math.round((Date.now() - Date.parse(iso)) / 60000);
  if (!isFinite(mins)) return '';
  if (mins &lt; 60) return mins + 'm';
  if (mins &lt; 1440) return Math.round(mins / 60) + 'h';
  return Math.round(mins / 1440) + 'd';
}
&lt;/script&gt;

&lt;body class="bg-base-100 text-base-content"&gt;
&lt;div x-data="page" class="fixed inset-0 grid grid-rows-[auto_1fr_auto]"&gt;

  &lt;!-- Header: what arrived, and where the read stands. --&gt;
  &lt;header class="border-b border-base-300 px-3 py-2 flex flex-col gap-1"&gt;
    &lt;div class="flex items-center gap-2 min-w-0"&gt;
      &lt;i class="ph ph-speaker-high text-lg"&gt;&lt;/i&gt;
      &lt;form @submit.prevent="setBranch(branchInput)" class="flex-1 min-w-0 flex gap-1"&gt;
        &lt;input x-model="branchInput" class="input input-sm input-bordered w-full font-mono" placeholder="owner/branch"&gt;
        &lt;button class="btn btn-sm btn-square" title="Look up"&gt;&lt;i class="ph ph-magnifying-glass"&gt;&lt;/i&gt;&lt;/button&gt;
      &lt;/form&gt;
      &lt;span class="badge badge-sm" :class="token ? 'badge-success' : 'badge-error'" x-text="token ? 'token' : 'no token'"&gt;&lt;/span&gt;
    &lt;/div&gt;
    &lt;div class="text-xs font-mono opacity-70 truncate"&gt;
      &lt;span x-text="'clipboard: ' + (clip ? JSON.stringify(clip.slice(0, 80)) : '(empty)')"&gt;&lt;/span&gt;
    &lt;/div&gt;
    &lt;div class="text-xs font-mono opacity-70 truncate" x-text="status"&gt;&lt;/div&gt;
  &lt;/header&gt;

  &lt;!-- Content: the index until a record is chosen, then its cards. --&gt;
  &lt;main class="min-h-0 overflow-y-auto"&gt;

    &lt;template x-if="!token"&gt;
      &lt;form @submit.prevent="setToken(tokenInput)" class="p-3 flex flex-col gap-2"&gt;
        &lt;input x-model="tokenInput" type="password" autocomplete="off" class="input input-bordered font-mono" placeholder="ghp_… (repo scope)"&gt;
        &lt;div class="flex gap-2"&gt;
          &lt;button class="btn btn-sm"&gt;Use token&lt;/button&gt;
          &lt;a class="btn btn-sm btn-ghost" :href="NEW_TOKEN"&gt;Get one&lt;/a&gt;
        &lt;/div&gt;
      &lt;/form&gt;
    &lt;/template&gt;

    &lt;template x-if="token &amp;&amp; !record"&gt;
      &lt;div&gt;
        &lt;template x-if="branch"&gt;
          &lt;ul class="menu w-full p-0"&gt;
            &lt;li class="menu-title font-mono text-xs" x-text="branch + ' · ' + hits.length"&gt;&lt;/li&gt;
            &lt;template x-for="row in hits" :key="row.id"&gt;
              &lt;li&gt;&lt;a @click.prevent="open(row)" class="w-full min-w-0 flex flex-col items-start gap-0 py-2"&gt;
                &lt;span class="text-base text-pretty" x-text="row.ask"&gt;&lt;/span&gt;
                &lt;span class="text-xs font-mono opacity-70" x-text="rowLine(row)"&gt;&lt;/span&gt;
              &lt;/a&gt;&lt;/li&gt;
            &lt;/template&gt;
            &lt;template x-if="!hits.length &amp;&amp; rows.length"&gt;&lt;li class="px-4 py-2 text-xs font-mono opacity-70"&gt;no session on this branch yet&lt;/li&gt;&lt;/template&gt;
          &lt;/ul&gt;
        &lt;/template&gt;
        &lt;ul class="menu w-full p-0"&gt;
          &lt;li class="menu-title font-mono text-xs" x-text="'latest ' + recent.length + ' of ' + rows.length"&gt;&lt;/li&gt;
          &lt;template x-for="row in recent" :key="'r' + row.id"&gt;
            &lt;li&gt;&lt;a @click.prevent="open(row)" class="w-full min-w-0 flex flex-col items-start gap-0 py-2"&gt;
              &lt;span class="text-base text-pretty" x-text="row.ask"&gt;&lt;/span&gt;
              &lt;span class="text-xs font-mono opacity-70" x-text="rowLine(row)"&gt;&lt;/span&gt;
            &lt;/a&gt;&lt;/li&gt;
          &lt;/template&gt;
        &lt;/ul&gt;
      &lt;/div&gt;
    &lt;/template&gt;

    &lt;template x-if="record"&gt;
      &lt;ul class="menu w-full p-0"&gt;
        &lt;li class="menu-title font-mono text-xs w-full flex flex-row justify-between"&gt;
          &lt;span x-text="record.short + ' · ' + record.day + ' · ' + deck.length + ' cards'"&gt;&lt;/span&gt;
          &lt;a class="link" :href="SESSION_PAGE + record.short"&gt;open page&lt;/a&gt;
        &lt;/li&gt;
        &lt;template x-for="c in deck" :key="c.key"&gt;
          &lt;li&gt;&lt;a @click.prevent="play(c.key)" class="w-full min-w-0 flex flex-col items-start gap-1 py-2"
                 :class="c.key === at ? 'menu-active' : ''"&gt;
            &lt;span class="text-xs font-mono opacity-70" x-text="c.label + (c.ts ? ' · ' + c.ts : '')"&gt;&lt;/span&gt;
            &lt;span class="w-full text-base text-pretty" x-text="c.lead"&gt;&lt;/span&gt;
            &lt;span class="w-full text-base opacity-70 text-pretty" x-show="c.closing &amp;&amp; c.closing !== c.lead" x-text="c.closing"&gt;&lt;/span&gt;
          &lt;/a&gt;&lt;/li&gt;
        &lt;/template&gt;
      &lt;/ul&gt;
    &lt;/template&gt;
  &lt;/main&gt;

  &lt;!-- Footer: the transport. --&gt;
  &lt;footer class="border-t border-base-300 px-2 py-1.5 flex items-center gap-1"&gt;
    &lt;button class="btn btn-sm btn-ghost btn-square" @click="back()" :disabled="!record" title="Back to the list"&gt;&lt;i class="ph ph-list"&gt;&lt;/i&gt;&lt;/button&gt;
    &lt;button class="btn btn-sm btn-square" @click="player &amp;&amp; player.prev()" :disabled="!deck.length"&gt;&lt;i class="ph ph-skip-back"&gt;&lt;/i&gt;&lt;/button&gt;
    &lt;button class="btn btn-sm btn-square btn-primary" @click="toggle()" :disabled="!deck.length || !speaks"&gt;
      &lt;i class="ph" :class="state === 'speaking' ? 'ph-pause' : 'ph-play'"&gt;&lt;/i&gt;
    &lt;/button&gt;
    &lt;button class="btn btn-sm btn-square" @click="player &amp;&amp; player.next()" :disabled="!deck.length"&gt;&lt;i class="ph ph-skip-forward"&gt;&lt;/i&gt;&lt;/button&gt;
    &lt;select class="select select-sm w-20" x-model="rate" @change="player &amp;&amp; player.setRate(rate)"&gt;
      &lt;option value="0.8"&gt;0.8×&lt;/option&gt;&lt;option value="1"&gt;1×&lt;/option&gt;&lt;option value="1.2"&gt;1.2×&lt;/option&gt;&lt;option value="1.5"&gt;1.5×&lt;/option&gt;
    &lt;/select&gt;
    &lt;span class="text-xs font-mono opacity-70 flex-1 text-center" x-text="deck.length ? (at + 1) + '/' + deck.length + ' · ' + state : (speaks ? '' : 'no speech here')"&gt;&lt;/span&gt;
    &lt;a class="btn btn-sm btn-ghost btn-square" :href="deck.length ? speakLink(spoken(at)) : '#'" :class="deck.length ? '' : 'btn-disabled'" title="Speak this card through Shortcuts"&gt;&lt;i class="ph ph-device-mobile-speaker"&gt;&lt;/i&gt;&lt;/a&gt;
  &lt;/footer&gt;
&lt;/div&gt;

&lt;script&gt;
document.addEventListener('alpine:init', function () {
  Alpine.data('page', function () {
    return {
      NEW_TOKEN: NEW_TOKEN, SESSION_PAGE: SESSION_PAGE,
      clip: '', branch: '', branchInput: '', token: '', tokenInput: '',
      rows: [], hits: [], recent: [], record: null, deck: [], at: 0,
      state: 'idle', rate: '1', status: 'starting', player: null,
      speaks: !!(window.readAloud &amp;&amp; window.readAloud.supported),

      init: function () {
        this.clip = CLIP === CLIP_KEY ? '' : fromB64(CLIP);
        this.token = TOKEN === TOKEN_KEY ? '' : TOKEN;
        this.branch = branchOf(this.clip);
        this.branchInput = this.branch;
        var self = this;
        if (this.speaks) this.player = window.readAloud.player({
          onState: function (s) { self.state = s.state; self.at = s.i; },
        });
        if (this.token) this.loadIndex();
        else this.status = 'opened without a token';
      },

      setToken: function (t) { t = (t || '').trim(); if (!t) return; this.token = t; this.loadIndex(); },
      setBranch: function (b) { this.branch = branchOf(b) || (b || '').trim(); this.back(); this.sift(); },

      get: async function (path) {
        var res = await fetch(API + path + '?ref=main', {
          headers: { Authorization: auth(this.token), Accept: 'application/vnd.github.raw+json' },
        });
        if (!res.ok) throw new Error('HTTP ' + res.status + ' on ' + path);
        return res.json();
      },

      loadIndex: async function () {
        this.status = 'reading ' + INDEX;
        try {
          var idx = await this.get(INDEX);
          this.rows = idx.rows || [];
          this.status = this.rows.length + ' sessions · index ' + ago(idx.generatedAt) + ' old';
          this.sift();
        } catch (e) { this.status = e.message; }
      },

      sift: function () {
        this.hits = matches(this.rows, this.branch);
        this.recent = latest(this.rows, LATEST);
      },

      open: async function (row) {
        var path = recordPath(row);
        this.status = 'reading ' + path;
        try {
          var rec = await this.get(path);
          this.record = rec;
          this.deck = cards(rec);
          this.at = 0;
          if (this.player) this.player.load(this.deck);
          this.status = row.id + ' · ' + this.deck.length + ' cards · ' + (rec.reply_chars || 0) + ' chars of reply';
          this.play(0);
        } catch (e) { this.status = e.message; }
      },

      back: function () {
        if (this.player) this.player.stop();
        this.record = null; this.deck = []; this.at = 0;
      },

      play: function (i) { if (this.player) { this.player.setRate(Number(this.rate)); this.player.play(i); } },
      toggle: function () { if (this.player) this.player.toggle(); },
      spoken: function (i) { return window.readAloud ? window.readAloud.speechText((this.deck[i] || {}).md || '') : ''; },
      speakLink: speakLink,
      rowLine: function (row) {
        return [row.id, row.day, (row.mins || 0) + 'm', (row.branches || [])[0] || ''].filter(Boolean).join(' · ');
      },
    };
  });
});
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
</string>
