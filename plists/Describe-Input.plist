				<string>((input) =&gt; {
  const cap = 32
  const clipEnd = s =&gt; (s = s ?? "", s.length &gt; cap ? s.slice(0, cap - 1) + "…" : s)
  const clipMid = s =&gt; {
    s = s ?? ""
    if (s.length &lt;= cap) return s
    const head = Math.floor((cap - 1) / 2), tail = (cap - 1) - head
    return s.slice(0, head) + "…" + s.slice(-tail)
