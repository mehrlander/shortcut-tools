      const exts = ext.split(/\r?\n/).map(s =&gt; s.trim()).filter(Boolean)
      let tagLabel = "mixed"
      if (exts.length) {
        const e0 = exts[0]
        let same = true
        for (const e of exts) if (e !== e0) { same = false; break }
        if (same) tagLabel = e0
