  const sans = s =&gt; String(s).toLowerCase().replace(/[a-z]/g, c =&gt; F[c.charCodeAt(0) - 97] || c)
  const sup = d =&gt; d === "0" ? "⁰" : "¹²³⁴⁵⁶⁷⁸⁹"[d.charCodeAt(0) - 49]
  const supNum = x =&gt; String(x).replace(/\d/g, d =&gt; sup(d))
  const supTag = x =&gt; "⁽" + supNum(x) + "⁾"
  const rpad = (s, w) =&gt; s + " ".repeat(Math.max(0, w - s.length))

  const RULES = {
    "icloud.com/shortcuts": "shortcut",
    "lawfilesext.leg.wa.gov": "lawfiles",
    "shortcuts://open-shortcut": "open shortcut",
    "shortcuts://run-shortcut": "run shortcut",
    "http": "URL"
  }
  const classifyUrl = u =&gt; {
    const hay = u.toLowerCase()
    const match = Object.entries(RULES).find(([k]) =&gt; hay.includes(k))
    return match ? match[1] : "URL"
  }
  const looksUrl = s =&gt; /^(https?:\/\/|shortcuts:\/\/)\S+$/i.test(s)

  const decodeB64 = b64 =&gt; {
