    const base64 = String(o["Base64"] || "")
    const count = Number(o["Count"] || 0) || 0
    const isList = count &gt; 1

    const first = base64.split(/\r?\n/)[0] || ""
    const preview = first.slice(0, 10) + (first.length &gt; 10 ? "…" : "")

    const rawType = String(o["Type"] || "")
    const name = String(o["Name"] || "")
