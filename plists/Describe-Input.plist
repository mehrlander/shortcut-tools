    const header = " ".repeat(Math.max(0, Math.floor((W - baseStr.length) / 2) + 2)) + baseStr

    let lines
    if (isList) {
      const names = name.split(/\r?\n/).map(s =&gt; s.trim())
      const exts  = ext.split(/\r?\n/).map(s =&gt; s.trim())
      const n = Math.max(count || 0, names.length, exts.length, 0)
      lines = []
      for (let i = 0; i &lt; n; i++) {
        const nm = names[i] || ""
        const ex = exts[i] || ""
        let fn = ex ? (nm ? (nm + "." + ex) : ("." + ex)) : nm
        if (!fn) fn = "Item " + (i + 1)
        lines.push(fn)
      }
      if (!lines.length) lines = ["LIST"]
    } else if (isUrlItem) {
      lines = [name || "", url].filter(Boolean)
      if (!lines.length) lines = ["URL"]
    } else {
      let textLines = null
      const looksBinary = !decoded || /[\x00-\x08\x0E-\x1F]/.test(decoded.slice(0, 200))
      if (!looksBinary) {
        textLines = decoded.split(/\r?\n/)
        while (textLines.length &amp;&amp; !textLines[textLines.length - 1]) textLines.pop()
      }
      lines = (textLines &amp;&amp; textLines.length) ? textLines : [fileName || "Item"]
    }

    const n = lines.length || 1
    const Lw = supTag(n).length
    const mid = lines.length &lt;= 2 ? "" : clipEnd(lines.slice(1, -1).join("\n").replace(/\r?\n/g, "␤"))
    const row = i =&gt; rpad(supTag(i), Lw) + " " + clipMid(lines[i - 1] || "")
    const body = [row(1), n == 2 ? row(2) : n &gt; 2 ? ("⋯" + (mid ? " " + mid : "")) : null, n &gt; 2 ? row(n) : null].filter(Boolean).join("\n")

    const detail = { type, fileName, preview, caption: header + "\n" + body }
    if (isUrlItem) detail.url = url

    return { ...o, detail }
  }

  const asList = items =&gt; {
    const join = k =&gt; items.map(o =&gt; String(o[k] || "")).join("\n")
    const summary = transformOne({ Count: items.length, Name: join("Name"),
      "File Extension": join("File Extension"), Base64: "" })
    return { list: items.map(transformOne), detail: summary.detail }
