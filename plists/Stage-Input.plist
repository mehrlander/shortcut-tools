				<key>WFJavaScript</key>
				<string>(async () =&gt; {
  const h = location.hostname || 'page';
  const items = [
    { name: h + '-link.txt', text: location.href },
    { name: h + '.html', text: '&lt;!DOCTYPE html&gt;\n' + document.documentElement.outerHTML }
  ];
  const gz = await new Response(new Blob([JSON.stringify(items)]).stream()
    .pipeThrough(new CompressionStream('gzip'))).arrayBuffer();
  const u = new Uint8Array(gz);
  let s = '';
  for (let i = 0; i &lt; u.length; i += 0x8000) s += String.fromCharCode.apply(null, u.subarray(i, i + 0x8000));
  completion(btoa(s));
})().catch(e =&gt; completion('ERROR ' + e));</string>
