{
  "name": "Run-Pick",
  "label": "Run-Pick: pick a verb from the input list, run it on the clipboard, show what came back (6 actions)",
  "workflow": {
    "WFWorkflowTypes": [
      "WFWorkflowTypeShowInSearch"
    ]
  },
  "actions": [
    {
      "id": "is.workflow.actions.comment",
      "p": {
        "WFCommentActionText": "One shortcut, no list crossing a shortcut boundary. The two-shortcut version handed Run-Pick a [payload, verbs] list through Run Shortcut and the list arrived TEXT-COERCED, newline-joined, so splitting it produced the clipboard line plus the four names and the menu offered the payload as a choice. Measured on device 2026-08-29. The verb list is the input, the payload is the clipboard, and the prompt is set: unset, iOS shows its own 'Which one?' which says nothing."
      }
    },
    {
      "id": "is.workflow.actions.getclipboard",
      "p": {
        "UUID": "91CE0000-0001-4A00-9000-000000000001"
      }
    },
    {
      "id": "is.workflow.actions.text.split",
      "p": {
        "UUID": "91CE0000-0002-4A00-9000-000000000001",
        "WFTextSeparator": "New Lines",
        "text": {
          "Value": {
            "Type": "ExtensionInput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.choosefromlist",
      "p": {
        "UUID": "91CE0000-0003-4A00-9000-000000000001",
        "WFChooseFromListActionPrompt": "Run which one on the clipboard?",
        "WFInput": {
          "Value": {
            "OutputName": "Split Text",
            "OutputUUID": "91CE0000-0002-4A00-9000-000000000001",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.runworkflow",
      "p": {
        "UUID": "91CE0000-0004-4A00-9000-000000000001",
        "WFWorkflowName": {
          "Value": {
            "attachmentsByRange": {
              "{0, 1}": {
                "OutputName": "Chosen Item",
                "OutputUUID": "91CE0000-0003-4A00-9000-000000000001",
                "Type": "ActionOutput"
              }
            },
            "string": "￼"
          },
          "WFSerializationType": "WFTextTokenString"
        },
        "WFInput": {
          "Value": {
            "OutputName": "Clipboard",
            "OutputUUID": "91CE0000-0001-4A00-9000-000000000001",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.showresult",
      "p": {
        "UUID": "91CE0000-0005-4A00-9000-000000000001",
        "Text": {
          "Value": {
            "attachmentsByRange": {
              "{0, 1}": {
                "OutputName": "Chosen Item",
                "OutputUUID": "91CE0000-0003-4A00-9000-000000000001",
                "Type": "ActionOutput"
              },
              "{4, 1}": {
                "OutputName": "Shortcut Result",
                "OutputUUID": "91CE0000-0004-4A00-9000-000000000001",
                "Type": "ActionOutput"
              }
            },
            "string": "￼ →\n￼"
          },
          "WFSerializationType": "WFTextTokenString"
        }
      }
    }
  ]
}
