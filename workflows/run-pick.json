{
  "name": "Run-Pick",
  "label": "Run-Pick: pick a verb from the input list, run it on the clipboard, show and log what came back (13 actions)",
  "workflow": {
    "WFWorkflowTypes": [
      "WFWorkflowTypeShowInSearch"
