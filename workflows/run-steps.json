      }
    },
    {
      "id": "is.workflow.actions.repeat.each",
      "p": {
        "GroupingIdentifier": "57E93000-9000-4A00-9000-000000009000",
        "WFControlFlowMode": 0,
        "WFInput": {
          "Value": {
            "OutputName": "Split Text",
            "OutputUUID": "57E93000-0001-4A00-9000-000000000001",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.runworkflow",
      "p": {
