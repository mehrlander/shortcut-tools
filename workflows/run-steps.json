        "WFInput": {
          "Value": {
            "Type": "Variable",
            "VariableName": "Carry"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.setvariable",
      "p": {
        "WFInput": {
          "Value": {
            "OutputName": "Shortcut Result",
