            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        },
        "WFVariableName": "Carry"
      }
    },
    {
      "id": "is.workflow.actions.repeat.each",
      "p": {
        "GroupingIdentifier": "57E93000-9000-4A00-9000-000000009000",
        "UUID": "57E93000-0003-4A00-9000-000000000003",
        "WFControlFlowMode": 2
      }
    },
    {
      "id": "is.workflow.actions.getvariable",
      "p": {
        "WFVariable": {
          "Value": {
            "Type": "Variable",
