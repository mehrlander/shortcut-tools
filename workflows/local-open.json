{
  "name": "Local-Open",
  "label": "Local-Open: reopen a copied loopback URL against the PC's LAN address (3 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.getclipboard",
      "p": {
        "UUID": "10CA0000-0001-4A00-9000-000000000001"
      }
    },
    {
      "id": "is.workflow.actions.text.replace",
      "p": {
        "UUID": "10CA0000-0002-4A00-9000-000000000002",
        "WFInput": {
          "Value": {
            "attachmentsByRange": {
              "{0, 1}": {
                "OutputName": "Clipboard",
                "OutputUUID": "10CA0000-0001-4A00-9000-000000000001",
                "Type": "ActionOutput"
              }
            },
            "string": "￼"
          },
          "WFSerializationType": "WFTextTokenString"
        },
        "WFReplaceTextFind": "127\\.0\\.0\\.1|localhost|\\[::1\\]|0\\.0\\.0\\.0",
        "WFReplaceTextRegularExpression": true,
        "WFReplaceTextReplace": "192.168.0.209"
      }
    },
    {
      "id": "is.workflow.actions.openurl",
      "p": {
        "UUID": "10CA0000-0003-4A00-9000-000000000003",
        "Show-WFInput": true,
        "WFInput": {
          "Value": {
            "OutputName": "Updated Text",
            "OutputUUID": "10CA0000-0002-4A00-9000-000000000002",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    }
  ]
}
