{
  "name": "Get-One",
  "label": "Get-One: one named shortcut through Filter Files, no loop (5 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.getmyworkflows",
      "p": {
        "UUID": "6E100000-0001-4A00-9000-000000000001"
      }
    },
    {
      "id": "is.workflow.actions.filter.files",
      "p": {
        "UUID": "6E100000-0002-4A00-9000-000000000001",
        "CustomOutputName": "Match",
        "WFContentItemInputParameter": {
          "Value": {
            "Type": "ActionOutput",
            "OutputUUID": "6E100000-0001-4A00-9000-000000000001",
            "OutputName": "My Shortcuts"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        },
        "WFContentItemLimitEnabled": true,
        "WFContentItemLimitNumber": 1,
        "WFContentItemFilter": {
          "Value": {
            "WFActionParameterFilterPrefix": 1,
            "WFContentPredicateBoundedDate": false,
            "WFActionParameterFilterTemplates": [
              {
                "Operator": 4,
                "Property": "Name",
                "Removable": true,
                "Values": {
                  "String": {
                    "Value": {
                      "string": "￼",
                      "attachmentsByRange": {
                        "{0, 1}": {
                          "Type": "ExtensionInput"
                        }
                      }
                    },
                    "WFSerializationType": "WFTextTokenString"
                  },
                  "Unit": 4
                }
              }
            ]
          },
          "WFSerializationType": "WFContentPredicateTableTemplate"
        }
      }
    },
    {
      "id": "is.workflow.actions.gettypeaction",
      "p": {
        "UUID": "6E100000-0003-4A00-9000-000000000001",
        "WFFileType": "public.json",
        "WFInput": {
          "Value": {
            "Type": "ActionOutput",
            "OutputUUID": "6E100000-0002-4A00-9000-000000000001",
            "OutputName": "Match"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.gettext",
      "p": {
        "UUID": "6E100000-0004-4A00-9000-000000000001",
        "CustomOutputName": "Record",
        "WFTextActionText": {
          "Value": {
            "string": "{\"op\":\"dump\",\"name\":\"￼\",\"build\":\"#BUILD#\",\"shortcut\":￼}",
            "attachmentsByRange": {
              "{21, 1}": {
                "Type": "ExtensionInput"
              },
              "{53, 1}": {
                "Type": "ActionOutput",
                "OutputUUID": "6E100000-0003-4A00-9000-000000000001",
                "OutputName": "File of Type"
              }
            }
          },
          "WFSerializationType": "WFTextTokenString"
        }
      }
    },
    {
      "id": "is.workflow.actions.runworkflow",
      "p": {
        "UUID": "6E100000-0005-4A00-9000-000000000001",
        "WFWorkflowName": "Log-Repo",
        "WFInput": {
          "Value": {
            "Type": "ActionOutput",
            "OutputUUID": "6E100000-0004-4A00-9000-000000000001",
            "OutputName": "Record"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    }
