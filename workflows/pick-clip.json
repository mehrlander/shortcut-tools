{
  "name": "Pick-Clip",
  "label": "Pick-Clip: pair the clipboard with the input's verb list and hand both to Run-Pick (4 actions)",
  "workflow": {
    "WFWorkflowTypes": [
      "WFWorkflowTypeShowInSearch"
    ]
  },
  "actions": [
    {
      "id": "is.workflow.actions.comment",
      "p": {
        "WFCommentActionText": "The link adapter, and the only place the two-argument awkwardness lives. A shortcuts:// link carries ONE text string, so it can never hand over the two-item list Run-Pick wants. The payload is the argument that may contain anything, including newlines, so it cannot be a delimited field; the verb list is bounded, so it can. This takes the bounded one as input, reads the payload from the clipboard, pairs them, and calls Run-Pick. Run-Pick itself stays pipeable."
      }
    },
