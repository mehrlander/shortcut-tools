          },
          "WFSerializationType": "WFTextTokenString"
        },
        "text": {
          "Value": {
            "string": "￼",
            "attachmentsByRange": {
              "{0, 1}": {
                "Type": "ActionOutput",
                "OutputUUID": "6A700000-0004-4A00-9000-000000000001",
                "OutputName": "Routes"
              }
            }
          },
          "WFSerializationType": "WFTextTokenString"
        }
