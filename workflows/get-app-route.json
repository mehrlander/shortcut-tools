{
  "name": "Get-AppRoute",
  "label": "Get-AppRoute: an app name in, the shortcut to run out, or nothing (5 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.conditional",
      "p": {
        "GroupingIdentifier": "6A700000-9001-4A00-9000-000000009001",
        "WFControlFlowMode": 0,
        "WFCondition": 101,
        "WFInput": {
          "Type": "Variable",
