{
 "name": "Read-Shots",
 "label": "Read-Shots: OCR a set of screenshots and commit the text to the repo log (11 actions)",
 "actions": [
  {
   "id": "is.workflow.actions.selectphoto",
   "p": {
    "UUID": "B77B0001-0000-4A00-9000-000000000001",
    "WFSelectMultiplePhotos": true
   }
  },
  {
   "id": "is.workflow.actions.count",
   "p": {
    "UUID": "B77B0002-0000-4A00-9000-000000000001",
    "WFCountType": "Items",
    "Input": {
     "Value": {
      "OutputName": "Photos",
      "OutputUUID": "B77B0001-0000-4A00-9000-000000000001",
      "Type": "ActionOutput"
     },
     "WFSerializationType": "WFTextTokenAttachment"
    }
   }
  },
  {
   "id": "is.workflow.actions.repeat.each",
   "p": {
    "GroupingIdentifier": "B77B9000-0000-4A00-9000-000000009000",
    "WFControlFlowMode": 0,
    "WFInput": {
     "Value": {
      "OutputName": "Photos",
      "OutputUUID": "B77B0001-0000-4A00-9000-000000000001",
      "Type": "ActionOutput"
     },
     "WFSerializationType": "WFTextTokenAttachment"
    }
   }
  },
  {
   "id": "is.workflow.actions.extracttextfromimage",
