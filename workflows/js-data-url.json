        "WFTextActionText": "<pre id=\"out\"></pre>\n<script>\n  var d = new Date(), y = d.getFullYear();\n  var doy = Math.floor((d - new Date(y,0,1)) / 86400000) + 1;\n  var leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0, total = leap ? 366 : 365;\n  document.getElementById('out').textContent =\n    'Day ' + doy + ' of ' + total + ', ' + Math.round(doy/total*100) + '% through ' + y;\n</script>"
