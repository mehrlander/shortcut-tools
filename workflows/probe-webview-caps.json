{
  "name": "Probe-WebViewCaps",
  "label": "Probe-WebViewCaps: every remaining sheet capability, returning itself (2 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.gettext",
      "p": {
        "UUID": "3B0EE400-0001-4A00-9000-000000000001",
        "WFTextActionText": "<html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head>\n<body style=\"font:17px -apple-system;padding:1.2em\">\n<h3 id=\"s\">running checks...</h3>\n<pre id=\"o\" style=\"font:15px ui-monospace;white-space:pre-wrap;background:#f2f2f7;padding:.8em;border-radius:8px\"></pre>\n<p><a id=\"send\" href=\"#\" style=\"display:none;font-size:20px;font-weight:600;padding:.7em 1.2em;background:#007aff;color:#fff;text-decoration:none;border-radius:10px\">Send results</a></p>\n<p id=\"c\" style=\"color:#666\"></p>\n<textarea id=\"buf\" inputmode=\"none\" style=\"position:absolute;opacity:0;top:-1000px\"></textarea>\n<script>\nconst r = {};\nconst line = () => Object.entries(r).map(([k,v]) => k+\"=\"+v).join(\" \");\nconst show = () => { document.getElementById(\"o\").textContent = line(); };\nconst t = (k, f) => { try { r[k] = f(); } catch (e) { r[k] = \"ERR:\" + e.name; } show(); };\n\nt(\"origin\", () => location.origin || \"null\");\nt(\"secure\", () => window.isSecureContext ? \"Y\" : \"N\");\nt(\"gz\", () => typeof DecompressionStream === \"function\" ? \"Y\" : \"N\");\nt(\"speech\", () => (\"webkitSpeechRecognition\" in window || \"SpeechRecognition\" in window) ? \"Y\" : \"N\");\nt(\"ls\", () => { localStorage.setItem(\"p\",\"1\"); const v = localStorage.getItem(\"p\"); localStorage.removeItem(\"p\"); return v === \"1\" ? \"Y\" : \"N\"; });\n\nconst copyLegacy = txt => {\n  const b = document.getElementById(\"buf\");\n  b.value = txt; b.focus(); b.select();\n  const ok = document.execCommand(\"copy\");\n  b.value = \"\";\n  return ok ? \"Y\" : \"N\";\n};\n\nconst done = () => {\n  r.copyexec = copyLegacy(line());\n  show();\n  const a = document.getElementById(\"send\");\n  a.href = \"shortcuts://run-shortcut?name=Log-Repo&input=text&text=\" + encodeURIComponent(\"sheet caps: \" + line());\n  a.style.display = \"inline-block\";\n  document.getElementById(\"s\").textContent = \"done\";\n  document.getElementById(\"c\").textContent = \"Tap Send results to commit them, or read the line above.\";\n};\n\nconst cdn = new Promise(res => {\n  const s = document.createElement(\"script\");\n  s.src = \"https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js\";\n  s.onload = () => res(\"Y\"); s.onerror = () => res(\"N\");\n  setTimeout(() => res(\"TIMEOUT\"), 6000);\n  document.head.appendChild(s);\n});\n\nconst mic = navigator.mediaDevices && navigator.mediaDevices.getUserMedia\n  ? navigator.mediaDevices.getUserMedia({audio:true})\n      .then(st => { st.getTracks().forEach(x => x.stop()); return \"Y\"; })\n      .catch(e => \"N:\" + e.name)\n  : Promise.resolve(\"NOAPI\");\n\nconst capi = navigator.clipboard\n  ? navigator.clipboard.writeText(\"x\").then(() => \"Y\").catch(e => \"N:\" + e.name)\n  : Promise.resolve(\"NOAPI\");\n\nPromise.all([cdn, mic, capi]).then(([c, m, k]) => { r.cdn = c; r.mic = m; r.copyapi = k; done(); });\n</script></body></html>"
      }
    },
    {
      "id": "is.workflow.actions.runworkflow",
      "p": {
        "UUID": "3B0EE400-0002-4A00-9000-000000000001",
        "WFWorkflowName": "Show-WebView",
        "WFInput": {
          "Value": {
            "OutputName": "Text",
            "OutputUUID": "3B0EE400-0001-4A00-9000-000000000001",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    }
  ]
}
