{
  "label": "Dump-Folder: one folder's shortcuts as JSON lines, onto the clipboard (8 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.getmyworkflows",
      "p": {
        "UUID": "D5E10000-0001-4A00-9000-000000000001",
        "Folder": {
          "Value": {
            "Type": "Ask"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.repeat.each",
      "p": {
        "GroupingIdentifier": "D5E10000-9000-4A00-9000-000000009000",
        "WFControlFlowMode": 0,
        "WFInput": {
          "Value": {
            "OutputName": "My Shortcuts",
            "OutputUUID": "D5E10000-0001-4A00-9000-000000000001",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.getitemname",
      "p": {
        "UUID": "D5E10000-0003-4A00-9000-000000000003",
        "WFInput": {
          "Value": {
            "Type": "Variable",
            "VariableName": "Repeat Item"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.gettypeaction",
      "p": {
        "UUID": "D5E10000-0004-4A00-9000-000000000004",
        "WFFileType": "public.json",
        "WFInput": {
          "Value": {
            "Type": "Variable",
            "VariableName": "Repeat Item"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.gettext",
      "p": {
        "UUID": "D5E10000-0005-4A00-9000-000000000005",
        "WFTextActionText": {
          "Value": {
            "attachmentsByRange": {
              "{9, 1}": {
                "OutputName": "Name",
                "OutputUUID": "D5E10000-0003-4A00-9000-000000000003",
                "Type": "ActionOutput"
              },
              "{23, 1}": {
                "OutputName": "File of Type",
                "OutputUUID": "D5E10000-0004-4A00-9000-000000000004",
                "Type": "ActionOutput"
              }
            },
            "string": "{\"name\":\"￼\",\"shortcut\":￼}"
          },
          "WFSerializationType": "WFTextTokenString"
        }
      }
    },
    {
      "id": "is.workflow.actions.repeat.each",
      "p": {
        "GroupingIdentifier": "D5E10000-9000-4A00-9000-000000009000",
        "UUID": "D5E10000-0006-4A00-9000-000000000006",
        "WFControlFlowMode": 2
      }
    },
    {
      "id": "is.workflow.actions.text.combine",
      "p": {
        "UUID": "D5E10000-0007-4A00-9000-000000000007",
        "WFTextSeparator": "New Lines",
        "text": {
          "Value": {
            "OutputName": "Repeat Results",
            "OutputUUID": "D5E10000-0006-4A00-9000-000000000006",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    },
    {
      "id": "is.workflow.actions.setclipboard",
      "p": {
        "UUID": "D5E10000-0008-4A00-9000-000000000008",
        "WFInput": {
          "Value": {
            "OutputName": "Combined Text",
            "OutputUUID": "D5E10000-0007-4A00-9000-000000000007",
            "Type": "ActionOutput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        }
      }
    }
  ]
}
