{
  "name": "Probe-Bench",
  "label": "Probe-Bench: Bench end to end on a baked-in payload, returning itself (7 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.comment",
      "p": {
        "WFCommentActionText": "Bench end to end, carrying its own input. Bench reads the clipboard, so this sets it first rather than asking for something to be copied, and logs the result rather than leaving it on the clipboard to be pasted back. Run-Steps could not do this: it splits its input into shortcut NAMES, so there is no slot left for a payload."
      }
    },
    {
