{
  "name": "Probe-InlineBench",
  "label": "Probe-InlineBench: whether a data: URL page can load a CDN library and use it (7 actions)",
  "actions": [
    {
      "id": "is.workflow.actions.comment",
      "p": {
        "WFCommentActionText": "The route left after Probe-TabJs. Run JavaScript on Web Page refuses a Tab entity, so a live page is reachable only through the share sheet; this needs no page at all. js-data-url already runs a script this way and returns its value, so the only open question is whether a library can be fetched and evaluated first, inside the coercion's capture moment. Four lines come back, so one tap separates failures that otherwise look alike."
      }
    },
    {
