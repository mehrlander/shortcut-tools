        "WFCondition": 4,
        "WFConditionalActionString": "Safari Web Page",
        "WFControlFlowMode": 0,
        "WFInput": {
          "Type": "Variable",
          "Variable": {
            "Value": {
              "OutputName": "Type",
              "OutputUUID": "57A6E000-0020-4A00-9000-000000000001",
