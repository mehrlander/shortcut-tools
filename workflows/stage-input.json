    {
      "id": "is.workflow.actions.runjavascriptonwebpage",
      "p": {
        "UUID": "57A6E000-0040-4A00-9000-000000000001",
        "WFInput": {
          "Value": {
            "Type": "ExtensionInput"
          },
          "WFSerializationType": "WFTextTokenAttachment"
        },
        "WFJavaScript": "(async () => {\n  let step = 'read';\n  try {\n  const h = location.hostname || 'page';\n  const json = JSON.stringify([\n    { name: h + '-link.txt', text: location.href },\n    { name: h + '.html', text: '<!DOCTYPE html>\\n' + document.documentElement.outerHTML }\n  ]);\n  const bytes = new TextEncoder().encode(json);\n  // Safari's CompressionStream refused a Blob stream's chunks (\"Invalid type\n  // should be ArrayBuffer\"), so hand it an ArrayBuffer, then a view if that fails.\n  const gzip = async (chunk) => {\n    const cs = new CompressionStream('gzip');\n    const w = cs.writable.getWriter();\n    w.write(chunk); w.close();\n    const r = cs.readable.getReader(), parts = [];\n    let n = 0;\n    for (;;) { const { done, value } = await r.read(); if (done) break; parts.push(value); n += value.byteLength; }\n    const out = new Uint8Array(n); let o = 0;\n    for (const p of parts) { out.set(new Uint8Array(p.buffer || p, p.byteOffset || 0, p.byteLength), o); o += p.byteLength; }\n    return out;\n  };\n  step = 'gzip';\n  let gz;\n  try { gz = await gzip(bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength)); }\n  catch (e) { step = 'gzip-view'; gz = await gzip(bytes); }\n  step = 'base64';\n  let s = '';\n  for (let i = 0; i < gz.length; i += 0x8000) s += String.fromCharCode.apply(null, gz.subarray(i, i + 0x8000));\n  completion(btoa(s));\n  } catch (e) { completion('ERROR ' + step + ': ' + e); }\n})();"
      }
    },
